<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console appender only. The level and the optional rotating file appender are applied at startup
  by fr.minobot.app.LoggerSetup, from config.json.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} | %-5level | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
